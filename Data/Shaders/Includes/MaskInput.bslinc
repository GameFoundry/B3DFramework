#include "$ENGINE$\RendererPassInput.bslinc"

mixin MaskInput
{
	code 
	{
		#ifndef MSAA_COUNT
			#define MSAA_COUNT 1
		#endif

		#if MSAA_COUNT > 1
		[internal]
		B3D_RENDERER_PASS_INPUT(Texture2DMS<float> gMaskTex, t3);
		#else
		[internal]
		B3D_RENDERER_PASS_INPUT(Texture2D<float> gMaskTex, t3);
		#endif
	};
};
