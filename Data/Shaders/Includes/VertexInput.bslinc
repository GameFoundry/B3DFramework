#include "$ENGINE$\VertexCommon.bslinc"

mixin VertexInput
{
	mixin VertexCommon;

	code
	{
		float4 GetVertexPosition(VertexInput input, VertexIntermediate intermediate)
		{
			return float4(input.position, 1.0f);
		}
		
		float4 GetVertexWorldPosition(VertexInput input, VertexIntermediate intermediate, float4x4 worldTransform)
		{
			return mul(worldTransform, GetVertexPosition(input, intermediate));
		}
		
		float4 GetVertexWorldPosition(VertexInput_PO input, float4x4 worldTransform)
		{
			return mul(worldTransform, float4(input.position, 1.0f));
		}
		
		// Note: This can be made optional if velocity buffer isn't required
		float4 GetPrevVertexWorldPosition(VertexInput input, VertexIntermediate intermediate, float4x4 previousWorldTransform)
		{
			#if DEFORMED && VERTEX_INPUT_PREVIOUS_CLIP_SPACE
				float4 position = float4(input.previousPosition, 1.0f);
			#else
				float4 position = float4(input.position, 1.0f);
			#endif
		
			return mul(previousWorldTransform, position);
		}
	};
};
