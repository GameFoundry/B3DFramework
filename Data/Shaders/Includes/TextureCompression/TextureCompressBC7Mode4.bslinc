// BC7 mode 4 candidate encoder. Each invocation evaluates one of the eight rotation/index-selector combinations. The
// dispatch maps those combinations to separate lanes and reduces them in lane order, keeping this kernel bounded while
// preserving the serial encoder's tie-breaking.
#include "$ENGINE$\TextureCompression\TextureCompressBC7Common.bslinc"

mixin TextureCompressBC7Mode4
{
	mixin TextureCompressBC7Common;

	code
	{
		uint4 CompressBC7Mode4Candidate(float4 texels[16], uint rotation, uint indexMode, out float outError)
		{
			int3 colors[16];
			int alphas[16];
			int alphaMin = 255;
			int alphaMax = 0;
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
			{
				const int4 pixel = (int4)round(saturate(texels[texelIndex]) * 255.0f);
				ApplyRotationBC7(pixel, rotation, colors[texelIndex], alphas[texelIndex]);
				alphaMin = min(alphaMin, alphas[texelIndex]);
				alphaMax = max(alphaMax, alphas[texelIndex]);
			}

			float3 colorEndpoint0;
			float3 colorEndpoint1;
			FitLineRGB(colors, 0xFFFFu, colorEndpoint0, colorEndpoint1);
			float alphaEndpoint0 = (float)alphaMax;
			float alphaEndpoint1 = (float)alphaMin;

			const uint colorBits = indexMode == 0u ? 2u : 3u;
			const uint alphaBits = indexMode == 0u ? 3u : 2u;
			int3 colorCode0 = int3(0, 0, 0);
			int3 colorCode1 = int3(0, 0, 0);
			int alphaCode0 = 0;
			int alphaCode1 = 0;
			uint colorIndices[16];
			uint alphaIndices[16];
			float error = 0.0f;

			for (uint refinePass = 0; refinePass < BCN_REFINE_PASSES; ++refinePass)
			{
				int3 reconstructedColor0 = int3(0, 0, 0);
				int3 reconstructedColor1 = int3(0, 0, 0);
				[unroll]
				for (int channel = 0; channel < 3; ++channel)
				{
					colorCode0[channel] = clamp((int)round(colorEndpoint0[channel] * (31.0f / 255.0f)), 0, 31);
					colorCode1[channel] = clamp((int)round(colorEndpoint1[channel] * (31.0f / 255.0f)), 0, 31);
					reconstructedColor0[channel] = (colorCode0[channel] << 3) | (colorCode0[channel] >> 2);
					reconstructedColor1[channel] = (colorCode1[channel] << 3) | (colorCode1[channel] >> 2);
				}

				alphaCode0 = clamp((int)round(alphaEndpoint0 * (63.0f / 255.0f)), 0, 63);
				alphaCode1 = clamp((int)round(alphaEndpoint1 * (63.0f / 255.0f)), 0, 63);
				const int reconstructedAlpha0 = (alphaCode0 << 2) | (alphaCode0 >> 4);
				const int reconstructedAlpha1 = (alphaCode1 << 2) | (alphaCode1 >> 4);

				float colorWeights[16];
				float alphaWeights[16];
				error = 0.0f;
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				{
					int bestColorIndex = 0;
					int bestColorError = 0x7fffffff;
					int bestAlphaIndex = 0;
					int bestAlphaError = 0x7fffffff;
					for (uint index = 0; index < 8; ++index)
					{
						if (index < (1u << colorBits))
						{
							const int weight = BC7IdxWeight((int)colorBits, index);
							const int3 paletteColor = ((64 - weight) * reconstructedColor0 +
								weight * reconstructedColor1 + 32) >> 6;
							const int3 difference = colors[texelIndex] - paletteColor;
							const int candidateError = difference.x * difference.x + difference.y * difference.y +
								difference.z * difference.z;
							if (candidateError < bestColorError)
							{
								bestColorError = candidateError;
								bestColorIndex = (int)index;
							}
						}

						if (index < (1u << alphaBits))
						{
							const int weight = BC7IdxWeight((int)alphaBits, index);
							const int paletteAlpha = ((64 - weight) * reconstructedAlpha0 +
								weight * reconstructedAlpha1 + 32) >> 6;
							const int difference = alphas[texelIndex] - paletteAlpha;
							const int candidateError = difference * difference;
							if (candidateError < bestAlphaError)
							{
								bestAlphaError = candidateError;
								bestAlphaIndex = (int)index;
							}
						}
					}

					error += (float)(bestColorError + bestAlphaError);
					colorIndices[texelIndex] = (uint)bestColorIndex;
					alphaIndices[texelIndex] = (uint)bestAlphaIndex;
					colorWeights[texelIndex] = (float)BC7IdxWeight((int)colorBits, (uint)bestColorIndex) * (1.0f / 64.0f);
					alphaWeights[texelIndex] = (float)BC7IdxWeight((int)alphaBits, (uint)bestAlphaIndex) * (1.0f / 64.0f);
				}

				if (refinePass + 1 < BCN_REFINE_PASSES)
				{
					RefineLineRGB(colors, 0xFFFFu, colorWeights, colorEndpoint0, colorEndpoint1);
					RefineScalar(alphas, 0xFFFFu, alphaWeights, alphaEndpoint0, alphaEndpoint1);
				}
			}

			const bool primaryIsColor = indexMode == 0u;
			uint primaryIndices[16];
			uint secondaryIndices[16];
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
			{
				primaryIndices[texelIndex] = primaryIsColor ? colorIndices[texelIndex] : alphaIndices[texelIndex];
				secondaryIndices[texelIndex] = primaryIsColor ? alphaIndices[texelIndex] : colorIndices[texelIndex];
			}

			if (primaryIndices[0] >= 2u)
			{
				if (primaryIsColor)
				{
					const int3 temporary = colorCode0;
					colorCode0 = colorCode1;
					colorCode1 = temporary;
				}
				else
				{
					const int temporary = alphaCode0;
					alphaCode0 = alphaCode1;
					alphaCode1 = temporary;
				}
				[unroll]
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
					primaryIndices[texelIndex] = 3u - primaryIndices[texelIndex];
			}

			if (secondaryIndices[0] >= 4u)
			{
				if (primaryIsColor)
				{
					const int temporary = alphaCode0;
					alphaCode0 = alphaCode1;
					alphaCode1 = temporary;
				}
				else
				{
					const int3 temporary = colorCode0;
					colorCode0 = colorCode1;
					colorCode1 = temporary;
				}
				[unroll]
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
					secondaryIndices[texelIndex] = 7u - secondaryIndices[texelIndex];
			}

			outError = error;
			uint4 block = uint4(0, 0, 0, 0);
			uint position = 0;
			PutBits(block, position, 0x10u, 5);
			PutBits(block, position, rotation, 2);
			PutBits(block, position, indexMode, 1);
			PutBits(block, position, (uint)colorCode0.x, 5); PutBits(block, position, (uint)colorCode1.x, 5);
			PutBits(block, position, (uint)colorCode0.y, 5); PutBits(block, position, (uint)colorCode1.y, 5);
			PutBits(block, position, (uint)colorCode0.z, 5); PutBits(block, position, (uint)colorCode1.z, 5);
			PutBits(block, position, (uint)alphaCode0, 6); PutBits(block, position, (uint)alphaCode1, 6);
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				PutBits(block, position, primaryIndices[texelIndex], texelIndex == 0u ? 1u : 2u);
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				PutBits(block, position, secondaryIndices[texelIndex], texelIndex == 0u ? 2u : 3u);

			return block;
		}
	};
};
