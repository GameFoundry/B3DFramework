// BC7 mode 3 encoder. Mode 3 is two-subset RGB (no alpha) like mode 1, but trades index precision for endpoint
// precision: 7-bit endpoints with a per-endpoint P-bit (8-bit effective) and 2-bit indices. Block layout (LSB->MSB):
// mode(4, ="0001") | partition(6) | R0 R1 R2 R3 G0 G1 G2 G3 B0 B1 B2 B3 (7 each) | P0 P1 P2 P3 (1 each, one per
// endpoint) | indices (2 bits each, the two subset anchors store 1 bit) = 128 bits.
//
// A cooperative search pass chooses the partition; this finalizer refines and packs that partition. Alpha is not
// represented (the decoder forces A=255), so the dispatcher adds the alpha penalty before comparing modes.
#include "$ENGINE$\TextureCompression\TextureCompressBC7Partition.bslinc"

mixin TextureCompressBC7Mode3
{
	mixin TextureCompressBC7Partition;

	code
	{
		uint4 PackBC7Mode3(int4 code[6], uint pbit[6], uint idx[16], uint partition)
		{
			const uint anchor1 = kBC7Anchor2[partition];
			uint4 block = uint4(0, 0, 0, 0);
			uint position = 0u;
			PutBits(block, position, 0x8u, 4u);
			PutBits(block, position, partition, 6u);
			[unroll]
			for (uint channel = 0u; channel < 3u; ++channel)
			{
				PutBits(block, position, (uint)code[0][channel], 7u);
				PutBits(block, position, (uint)code[1][channel], 7u);
				PutBits(block, position, (uint)code[2][channel], 7u);
				PutBits(block, position, (uint)code[3][channel], 7u);
			}
			PutBits(block, position, pbit[0], 1u);
			PutBits(block, position, pbit[1], 1u);
			PutBits(block, position, pbit[2], 1u);
			PutBits(block, position, pbit[3], 1u);
			[unroll]
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
				PutBits(block, position, idx[texelIndex], (texelIndex == 0u || texelIndex == anchor1) ? 1u : 2u);

			return block;
		}

		// Encodes a 4x4 RGB block into a 128-bit BC7 mode-3 block. @p outErr receives the total squared RGB reconstruction
		// error.
		uint4 CompressBC7Mode3(float3 texels[16], uint partition, out float outErr)
		{
			int4 px[16];
			[unroll]
			for (uint i = 0; i < 16; ++i)
				px[i] = int4((int3)round(saturate(texels[i]) * 255.0f), 0);

			int4 code[6];
			uint pbit[6];
			uint idx[16];
			FinalizeBC7Partition(px, 2, 3, 7, 1, 2, (int)partition, code, pbit, idx, outErr);
			return PackBC7Mode3(code, pbit, idx, partition);
		}
	};
};
