// BC7 mode 5 candidate encoder. One invocation evaluates one channel rotation; four cooperating lanes evaluate all
// rotations and reduce them in the original serial order.
#include "$ENGINE$\TextureCompression\TextureCompressBC7Common.bslinc"

mixin TextureCompressBC7Mode5
{
	mixin TextureCompressBC7Common;

	code
	{
		uint4 CompressBC7Mode5Candidate(float4 texels[16], uint rotation, out float outError)
		{
			int3 colors[16];
			int alphas[16];
			int alphaMin = 255;
			int alphaMax = 0;
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
			{
				const int4 pixel = (int4)round(saturate(texels[texelIndex]) * 255.0f);
				ApplyRotationBC7(pixel, rotation, colors[texelIndex], alphas[texelIndex]);
				alphaMin = min(alphaMin, alphas[texelIndex]);
				alphaMax = max(alphaMax, alphas[texelIndex]);
			}

			float3 colorEndpoint0;
			float3 colorEndpoint1;
			FitLineRGB(colors, 0xFFFFu, colorEndpoint0, colorEndpoint1);
			float alphaEndpoint0 = (float)alphaMax;
			float alphaEndpoint1 = (float)alphaMin;

			int3 colorCode0 = int3(0, 0, 0);
			int3 colorCode1 = int3(0, 0, 0);
			int alphaCode0 = 0;
			int alphaCode1 = 0;
			uint colorIndices[16];
			uint alphaIndices[16];
			float error = 0.0f;

			for (uint refinePass = 0; refinePass < BCN_REFINE_PASSES; ++refinePass)
			{
				int3 reconstructedColor0 = int3(0, 0, 0);
				int3 reconstructedColor1 = int3(0, 0, 0);
				[unroll]
				for (int channel = 0; channel < 3; ++channel)
				{
					colorCode0[channel] = clamp((int)round(colorEndpoint0[channel] * (127.0f / 255.0f)), 0, 127);
					colorCode1[channel] = clamp((int)round(colorEndpoint1[channel] * (127.0f / 255.0f)), 0, 127);
					reconstructedColor0[channel] = ExpandBC7(colorCode0[channel], 7);
					reconstructedColor1[channel] = ExpandBC7(colorCode1[channel], 7);
				}

				alphaCode0 = clamp((int)round(alphaEndpoint0), 0, 255);
				alphaCode1 = clamp((int)round(alphaEndpoint1), 0, 255);

				float colorWeights[16];
				float alphaWeights[16];
				error = 0.0f;
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				{
					int bestColorIndex = 0;
					int bestColorError = 0x7fffffff;
					int bestAlphaIndex = 0;
					int bestAlphaError = 0x7fffffff;
					for (uint index = 0; index < 4; ++index)
					{
						const int weight = (int)kBC7Weight2[index];
						const int3 paletteColor = ((64 - weight) * reconstructedColor0 +
							weight * reconstructedColor1 + 32) >> 6;
						const int3 colorDifference = colors[texelIndex] - paletteColor;
						const int colorError = colorDifference.x * colorDifference.x +
							colorDifference.y * colorDifference.y + colorDifference.z * colorDifference.z;
						if (colorError < bestColorError)
						{
							bestColorError = colorError;
							bestColorIndex = (int)index;
						}

						const int paletteAlpha = ((64 - weight) * alphaCode0 + weight * alphaCode1 + 32) >> 6;
						const int alphaDifference = alphas[texelIndex] - paletteAlpha;
						const int alphaError = alphaDifference * alphaDifference;
						if (alphaError < bestAlphaError)
						{
							bestAlphaError = alphaError;
							bestAlphaIndex = (int)index;
						}
					}

					error += (float)(bestColorError + bestAlphaError);
					colorIndices[texelIndex] = (uint)bestColorIndex;
					alphaIndices[texelIndex] = (uint)bestAlphaIndex;
					colorWeights[texelIndex] = (float)kBC7Weight2[bestColorIndex] * (1.0f / 64.0f);
					alphaWeights[texelIndex] = (float)kBC7Weight2[bestAlphaIndex] * (1.0f / 64.0f);
				}

				if (refinePass + 1 < BCN_REFINE_PASSES)
				{
					RefineLineRGB(colors, 0xFFFFu, colorWeights, colorEndpoint0, colorEndpoint1);
					RefineScalar(alphas, 0xFFFFu, alphaWeights, alphaEndpoint0, alphaEndpoint1);
				}
			}

			if (colorIndices[0] >= 2u)
			{
				const int3 temporary = colorCode0;
				colorCode0 = colorCode1;
				colorCode1 = temporary;
				[unroll]
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
					colorIndices[texelIndex] = 3u - colorIndices[texelIndex];
			}
			if (alphaIndices[0] >= 2u)
			{
				const int temporary = alphaCode0;
				alphaCode0 = alphaCode1;
				alphaCode1 = temporary;
				[unroll]
				for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
					alphaIndices[texelIndex] = 3u - alphaIndices[texelIndex];
			}

			outError = error;
			uint4 block = uint4(0, 0, 0, 0);
			uint position = 0;
			PutBits(block, position, 0x20u, 6);
			PutBits(block, position, rotation, 2);
			PutBits(block, position, (uint)colorCode0.x, 7); PutBits(block, position, (uint)colorCode1.x, 7);
			PutBits(block, position, (uint)colorCode0.y, 7); PutBits(block, position, (uint)colorCode1.y, 7);
			PutBits(block, position, (uint)colorCode0.z, 7); PutBits(block, position, (uint)colorCode1.z, 7);
			PutBits(block, position, (uint)alphaCode0, 8); PutBits(block, position, (uint)alphaCode1, 8);
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				PutBits(block, position, colorIndices[texelIndex], texelIndex == 0u ? 1u : 2u);
			[unroll]
			for (uint texelIndex = 0; texelIndex < 16; ++texelIndex)
				PutBits(block, position, alphaIndices[texelIndex], texelIndex == 0u ? 1u : 2u);

			return block;
		}
	};
};
